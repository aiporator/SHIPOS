# Frontend env vars (CRA — must be prefixed REACT_APP_)
#
# Backend URL. In deployed Vercel builds this is unused because vercel.json
# rewrites /api/* to the backend; the resolver in src/lib/api.js falls back
# to same-origin. Keep it set for local dev (`yarn start` on :3000 → :8001).
REACT_APP_BACKEND_URL=http://localhost:8001

# Show the dev quick-login panel on /login. MUST remain unset or "false" in
# production builds — the panel exposes test-account credentials.
REACT_APP_SHOW_QUICK_LOGIN=false

# Don't ship source maps to production users.
GENERATE_SOURCEMAP=false

# --- Analytics & error reporting ---
#
# PostHog is loaded as an inline snippet in public/index.html (EU host,
# project key phc_xmMQne...). These vars are documented for future migration
# to env-driven init in src/lib/analytics.js.
REACT_APP_POSTHOG_KEY=phc_xmMQneHWug8LVcr94h4vt8pVzDKstBXrYmSgu2moVdE8
REACT_APP_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry — not yet wired. To enable: `yarn add @sentry/react` then init in
# src/index.js using the DSN below. See docs/INTEGRATIONS.md §3.
# REACT_APP_SENTRY_DSN=
# REACT_APP_SENTRY_ENV=production
