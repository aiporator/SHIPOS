# Backend env vars (/app/backend/.env on the deployed host)

# --- Persistence ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=leadership_os

# --- LLM + Voice ---
EMERGENT_LLM_KEY=                    # GPT-5.2 + Whisper + Image Gen (Emergent Universal Key)
ELEVENLABS_API_KEY=                  # Voice cloning for Wlad + Challenger voices

# --- Payments (Stripe) ---
# Production cutover: replace sk_test_* with sk_live_* and register the
# webhook at https://leader-os.de/api/webhook/stripe (signing secret optional).
STRIPE_API_KEY=sk_test_emergent

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=reminders@leader-os.de
# Optional inbox for enterprise lead notifications; falls back to SENDER_EMAIL.
ENTERPRISE_LEAD_EMAIL=sales@leader-os.de

# --- Cron auth (defense in depth) ---
# Optional shared secret for /api/cron/* endpoints. When set, callers must
# send the matching value in the X-Cron-Secret header. Unset = endpoints
# stay open (backwards compatible). Generate with: `openssl rand -hex 32`.
# Also add the same value as the GitHub Actions repo secret CRON_SHARED_SECRET
# so the scheduled workflow keeps working.
CRON_SHARED_SECRET=

# --- Supabase (WladHub bi-directional sync) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
